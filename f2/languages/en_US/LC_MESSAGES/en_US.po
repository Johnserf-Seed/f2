#: f2/apps/twitter/cli.py f2/apps/weibo/cli.py
msgid "代理服务器不可用"
msgstr "The proxy server is unavailable"

#: f2/apps/bark/cli.py
msgid "Bark 是一个iOS端的通知推送工具"
msgstr "Bark is a push notification app for iOS"

#: f2/apps/bark/cli.py
msgid "配置文件路径，最低优先"
msgstr "Configuration file path, lowest priority"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "Bark 的 API Key"
msgstr "Bark API key"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "Bark 的 Device Token"
msgstr "Bark device token"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "选择发送模式，get：使用 GET 请求发送通知，post：使用 POST 请求发送通知，cipher：加密发送通知，默认为 get"
msgstr ""
"Sending mode. get: send the notification with a GET request; post: send "
"it with a POST request; cipher: send an encrypted notification. Defaults "
"to get"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "推送的标题"
msgstr "Notification title"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "推送的内容"
msgstr "Notification content"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "是否持续响铃，默认关闭"
msgstr "Keep ringing; off by default"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "推送级别。active：默认，timeSensitive：时效性通知，passive：被动通知，critical：紧急通知"
msgstr ""
"Notification level. active: default; timeSensitive: time-sensitive "
"notification; passive: passive notification; critical: critical alert"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "推送音量，范围 0-10"
msgstr "Notification volume, 0-10"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "推送的角标数量"
msgstr "Badge number of the notification"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "是否自动复制推送内容（iOS 14.5 及以上需手动长按复制）"
msgstr ""
"Copy the notification content automatically (on iOS 14.5 and later, long-"
"press to copy manually)"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "指定要复制的内容，若未指定则复制整个推送内容"
msgstr "Content to copy; the whole notification is copied if not specified"

