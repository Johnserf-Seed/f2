msgid "推送图标 URL，相同的图标 URL 仅下载一次"
msgstr "Notification icon URL; the same icon URL is downloaded only once"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "推送分组，通知中心将按分组显示推送"
msgstr "Notification group; Notification Center groups notifications by it"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "是否保存推送，默认保存"
msgstr "Save the notification; on by default"

#: f2/apps/bark/cli.py f2/apps/bark/help.py
msgid "点击推送时跳转的 URL，支持 URL Scheme 和 Universal Link"
msgstr ""
"URL to open when the notification is tapped; URL schemes and universal "
"links are supported"

